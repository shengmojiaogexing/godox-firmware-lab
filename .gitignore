# ============================================================
# 神牛固件研究工坊 (.gitignore)
# 原则：不发布厂商固件/升级工具等受版权保护的内容，不发布本机运行时与生成物。
# ============================================================

# ---------- 固件二进制（版权归权利人，禁止再分发）----------
*.bin
*.hex
*.s19
*.elf
*.map

# ---------- 本机私有密钥 / 本地配置 ----------
keypatch/KEY.txt
*.key
.env
.env.*

# ---------- 生成物 / 构建产物 ----------
keypatch/out/
keypatch/build/
studio/builds/
**/__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
**/lcd_out/
**/emu/logs/
*.tmp
*.bak
*.orig
*.rej

# ---------- 日志 ----------
*.log

# ---------- 便携运行时 / 第三方大件（本机已下载，不入库）----------
tools/python/
tools/jdk/
tools/dl/
tools/ghidra*/
tools/*.zip
devices/x3c/py/
devices/ad200pro/python/
