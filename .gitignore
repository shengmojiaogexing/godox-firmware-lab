**/Lib/
*.pyd
*.dll
*.exe
*.msi
*.pkl
*.7z
*.rar

# ---------- 厂商文档 / 官方升级包 / 本地 vendor 缓存 ----------
*.pdf
*.zip
vendor/

# ---------- 独立仓库与副本（各自有 GitHub 仓库，本项目不重复收录）----------
Godox-S3-Trigger/
Godox-S3-Trigger-main/

# ---------- 编辑器 / 系统 ----------
.vscode/
.idea/
*.swp
.DS_Store
