# ===========================================================================
# GitHub 语言统计排除规则（linguist）
#
# 以下文件是逆向工具自动产出的（Ghidra 反编译 C、capstone 伪 C、函数表、
# 字符串转储等），并非本项目手写源码。标记为 generated 后不计入语言构成，
# 文件本身仍保留在仓库中。
#
# 关键：只按扩展名排除产出物，绝不整目录排除，
# 因为 devices/*/re/ 下同时存在手写的 .py 分析脚本，必须计入统计。
# linguist 的 glob 不能跨目录用 `**`，故用 `*` 逐级列出。
# ===========================================================================

# --- Ghidra / capstone 反编译产物：C 源码 ---
devices/*/re/*.c linguist-generated=true
devices/*/re/*/*.c linguist-generated=true
devices/*/re/*/*/*.c linguist-generated=true
devices/*/re/*/*/*/*.c linguist-generated=true
devices/*/re/*/*/*/*/*.c linguist-generated=true
devices/*/out/*.c linguist-generated=true
devices/*/out/*/*.c linguist-generated=true
devices/*/out/*/*/*.c linguist-generated=true
devices/*/decompiled/*.c linguist-generated=true
devices/*/decompiled/*/*.c linguist-generated=true
keypatch/out/*.c linguist-generated=true

# --- 逆向导出的数据文件（函数表 / 外设映射 / 字符串转储）---
devices/*/re/*.txt linguist-generated=true
devices/*/re/*/*.txt linguist-generated=true
devices/*/re/*/*/*.txt linguist-generated=true
devices/*/re/*.csv linguist-generated=true
devices/*/re/*/*.csv linguist-generated=true
devices/*/re/*.tsv linguist-generated=true
devices/*/re/*/*.tsv linguist-generated=true
devices/*/re/*.json linguist-generated=true
devices/*/re/*/*.json linguist-generated=true
devices/*/out/*.json linguist-generated=true
devices/*/out/*/*.json linguist-generated=true

# --- 日志与调试转储 ---
*.log linguist-generated=true

# --- 文档与图片不计入语言统计 ---
*.md linguist-documentation
*.png linguist-documentation
*.svg linguist-documentation

# --- 自动反编译产物已从仓库移除（见 .gitignore 与 LEGAL.md）---
# 以下规则保留作为兜底：即使本机重新生成，也不计入语言统计。
